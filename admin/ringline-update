#!/usr/bin/env python3
"""Merge the newest upstream rustls release on this branch's line.

Run from the repository root with the ringline branch checked out (for
example ringline/0.23). The script:

1. Reads the merged upstream tag from RINGLINE.md (`Upstream: v/0.23.N`) and
   the newest `v/0.23.*` tag at UPSTREAM. Moving to another line (0.24) is
   done by hand.
2. Merges that tag into a new branch, `ringline-update/0.23.M`.
3. Resolves a conflicted file by taking upstream's version, when the fork's
   copy is exactly what admin/ringline-apply-rename makes of the old
   upstream copy, so the fork has no other change in it. Any other conflict
   is left to a person: the merge is abandoned and an issue names the files.
4. Runs admin/ringline-apply-rename with the next patch version, regenerates
   Cargo.lock and fuzz/Cargo.lock from upstream's with
   `cargo update --workspace`, updates the `Upstream:` line, and commits.
5. With --push, pushes the branch and opens a pull request. It names the
   advisories the release fixes when cargo-audit is installed.

A failure after the merge also opens an issue. Nothing is done twice: an
existing pull request for the release (labelled `security` under
--security) or an open issue with the same title stops the run. Under
--security with no newer upstream release, an issue asks for a backport.

Usage: admin/ringline-update [--upstream URL] [--push] [--security]
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile

UPSTREAM = "https://github.com/rustls/rustls.git"
LOCKFILES = {"Cargo.lock": "Cargo.toml", "fuzz/Cargo.lock": "fuzz/Cargo.toml"}


class Failed(Exception):
    pass


def run(*args, check=True):
    r = subprocess.run(args, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise Failed(f"`{' '.join(args)}` failed:\n{r.stdout}{r.stderr}")
    return r.stdout.strip()


def version_tuple(v):
    return tuple(int(x) for x in v.split("."))


def merged_upstream():
    m = re.search(r"^Upstream: v/(\d+\.\d+\.\d+)$", open("RINGLINE.md").read(), re.M)
    if not m:
        sys.exit("RINGLINE.md: no `Upstream: v/X.Y.Z` line")
    return m.group(1)


def fork_version():
    text = open("rustls/Cargo.toml").read()
    return re.search(r'^version = "(\d+\.\d+\.\d+)"$', text, re.M).group(1)


def newest_on_line(upstream_url, current):
    line = ".".join(current.split(".")[:2])
    run("git", "fetch", "--quiet", upstream_url, f"refs/tags/v/{line}.*:refs/tags/v/{line}.*")
    tags = run("git", "tag", "--list", f"v/{line}.*").split()
    versions = [t[2:] for t in tags if re.fullmatch(rf"v/{re.escape(line)}\.\d+", t)]
    newer = [v for v in versions if version_tuple(v) > version_tuple(current)]
    return max(newer, key=version_tuple) if newer else None


def mechanical_files(paths, old_tag, version):
    """The paths whose fork copy (at HEAD) equals admin/ringline-apply-rename's
    output on the `old_tag` tree."""
    if not paths:
        return set()
    tmp = tempfile.mkdtemp(prefix="ringline-update-")
    try:
        run("git", "worktree", "add", "--quiet", "--detach", tmp, f"refs/tags/{old_tag}")
        os.makedirs(os.path.join(tmp, "admin"), exist_ok=True)
        shutil.copy("admin/ringline-apply-rename", os.path.join(tmp, "admin"))
        subprocess.run(
            ["python3", "admin/ringline-apply-rename", "--version", version],
            cwd=tmp, check=True, capture_output=True,
        )
        same = set()
        for p in paths:
            old = os.path.join(tmp, p)
            ours = subprocess.run(["git", "show", f"HEAD:{p}"], capture_output=True)
            if os.path.exists(old) and ours.returncode == 0 and open(old, "rb").read() == ours.stdout:
                same.add(p)
        return same
    finally:
        run("git", "worktree", "remove", "--force", tmp, check=False)
        shutil.rmtree(tmp, ignore_errors=True)


def advisory_ids(version):
    """RustSec IDs against rustls `version`, or None without cargo-audit."""
    if shutil.which("cargo-audit") is None:
        return None
    out = subprocess.run(
        ["python3", "admin/ringline-advisory-check", "--ids", version], capture_output=True, text=True
    )
    return set(out.stdout.split()) if out.returncode == 0 else None


def gh(*args, check=True):
    return run("gh", *args, check=check)


def open_issue(title, body, push):
    print(body)
    if push and gh("issue", "list", "--search", f'"{title}" in:title', "--state", "open",
                   "--json", "number", "--jq", "length") == "0":
        gh("issue", "create", "--title", title, "--body", body)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--upstream", default=UPSTREAM)
    ap.add_argument("--push", action="store_true", help="push the branch and open a pull request or issue")
    ap.add_argument("--security", action="store_true", help="an advisory started this run")
    opts = ap.parse_args()

    base_branch = run("git", "rev-parse", "--abbrev-ref", "HEAD")
    current = merged_upstream()
    newest = newest_on_line(opts.upstream, current)
    if newest is None:
        print(f"no upstream release after v/{current}")
        if opts.security:
            open_issue(
                f"Advisory against rustls v/{current} with no newer 0.23 release",
                f"The advisory check reports an advisory against rustls `v/{current}`, which "
                f"`{base_branch}` contains, and upstream has no newer release on this line. The "
                f"fix needs backporting by hand. Run `admin/ringline-advisory-check` for the IDs.",
                opts.push,
            )
        return
    tag = f"v/{newest}"
    branch = f"ringline-update/{newest}"
    title = f"Merge upstream rustls {tag}"
    print(f"merging {tag} (merged: v/{current})")

    if opts.push:
        if opts.security:
            gh("label", "create", "security", "--color", "d73a4a", "--force")
        existing = gh("pr", "list", "--head", branch, "--state", "all", "--json", "number,state",
                      "--jq", '.[] | select(.state == "OPEN") | .number')
        if existing:
            if opts.security:
                gh("pr", "edit", existing.split()[0], "--add-label", "security")
            print(f"pull request #{existing.split()[0]} for {branch} is open")
            return
        if gh("issue", "list", "--search", f'"{title}" in:title', "--state", "open",
              "--json", "number", "--jq", "length") != "0":
            print(f"an open issue for {tag} exists")
            return

    # The fork's version, read before a conflict replaces the manifest.
    major, minor, patch = version_tuple(fork_version())
    version = f"{major}.{minor}.{patch}"
    next_version = f"{major}.{minor}.{patch + 1}"

    run("git", "checkout", "--quiet", "-B", branch)
    try:
        merge = subprocess.run(["git", "merge", "--no-ff", "--no-commit", f"refs/tags/{tag}"],
                               capture_output=True, text=True)
        conflicts = run("git", "diff", "--name-only", "--diff-filter=U").split()
        if merge.returncode != 0 and not conflicts:
            raise Failed(f"git merge failed:\n{merge.stdout}{merge.stderr}")
        candidates = [f for f in conflicts if f not in LOCKFILES]
        mechanical = mechanical_files(candidates, f"v/{current}", version)
        other = [f for f in candidates if f not in mechanical]
        if other:
            run("git", "merge", "--abort")
            run("git", "checkout", "--quiet", base_branch)
            run("git", "branch", "-D", branch)
            open_issue(
                title,
                f"Merging upstream `{tag}` into `{base_branch}` conflicts in files that hold "
                f"ringline changes, which need resolving by hand:\n\n"
                + "".join(f"- `{f}`\n" for f in other)
                + f"\nMerged upstream so far: `v/{current}`.",
                opts.push,
            )
            return
        for f in conflicts:
            run("git", "checkout", "--theirs", "--", f)
        run("python3", "admin/ringline-apply-rename", "--version", next_version)
        text = open("RINGLINE.md").read()
        open("RINGLINE.md", "w").write(re.sub(r"^Upstream: v/\S+$", f"Upstream: {tag}", text, flags=re.M))
        for lock, manifest in LOCKFILES.items():
            if os.path.exists(manifest):
                run("cargo", "update", "--quiet", "--workspace", "--manifest-path", manifest)
        run("git", "add", "-A")
        run(
            "git", "commit", "--quiet", "-m",
            f"Merge upstream rustls {tag}; ringline-tls {next_version}\n\n"
            f"Upstream: {tag}\n"
            + (f"Resolved with admin/ringline-apply-rename: {', '.join(conflicts)}\n" if conflicts else ""),
        )
    except Failed as e:
        run("git", "merge", "--abort", check=False)
        run("git", "reset", "--quiet", "--hard", check=False)
        run("git", "checkout", "--quiet", base_branch, check=False)
        run("git", "branch", "-D", branch, check=False)
        open_issue(title, f"Merging upstream `{tag}` into `{base_branch}` failed:\n\n```\n{e}\n```", opts.push)
        return
    print(f"committed on {branch}: ringline-tls {next_version}")

    if not opts.push:
        return
    old_ids, new_ids = advisory_ids(current), advisory_ids(newest)
    if old_ids is None or new_ids is None:
        advisories = "Advisories fixed: not checked (cargo-audit is not installed).\n\n"
    elif old_ids - new_ids:
        advisories = f"Advisories fixed: {', '.join(sorted(old_ids - new_ids))}.\n\n"
    else:
        advisories = "Advisories fixed: none.\n\n"
    run("git", "push", "--quiet", "--force", "origin", branch)
    body = (
        f"Merges upstream rustls `{tag}` into `{base_branch}` and sets ringline-tls "
        f"{next_version}.\n\nUpstream: {tag}\n\n"
        + advisories
        + (f"Conflicts resolved with `admin/ringline-apply-rename`: {', '.join(f'`{c}`' for c in conflicts)}.\n\n"
           if conflicts else "")
        + f"Upstream changes: https://github.com/rustls/rustls/compare/v/{current}...{tag}\n\n"
        "Merge with a merge commit, not a squash: the next update merges from this one's "
        f"upstream parent. Then tag the merge commit `v{next_version}` to publish."
    )
    args = ["pr", "create", "--base", base_branch, "--head", branch, "--title", title, "--body", body]
    if opts.security:
        args += ["--label", "security"]
    gh(*args)


if __name__ == "__main__":
    main()
