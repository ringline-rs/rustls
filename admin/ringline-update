#!/usr/bin/env python3
"""Merge the newest upstream rustls release on this branch's line.

Run from the repository root with the ringline branch checked out (for
example ringline/0.23). The script:

1. Reads the merged upstream tag from RINGLINE.md (`Upstream: v/0.23.N`) and
   the newest `v/0.23.*` tag at UPSTREAM. Moving to another line (0.24) is
   done by hand.
2. Merges that tag into a new branch, `ringline-update/0.23.M`.
3. Resolves each conflicted file with a three-way merge in which both
   upstream copies have first been put through admin/ringline-apply-rename:
   `git merge-file <fork copy> <apply-rename(old upstream)>
   <apply-rename(new upstream)>`. The fork's mechanical changes then match on
   both sides, so only its other changes can conflict. A file upstream
   deleted, which the fork changed only mechanically, is deleted. A file
   whose merge still conflicts is left to a person: the merge is abandoned
   and an issue names the files.
4. Runs admin/ringline-apply-rename with the next patch version, updates the
   lockfiles with `cargo update --workspace` (starting from upstream's copy
   when one conflicted), and re-locks each package the fork had moved away
   from the old upstream lockfile, when the fork's version is newer than and
   compatible with the new one. A re-lock that cargo refuses is listed in
   the commit and the pull request. It also updates the `Upstream:` line,
   then commits.
5. With --push, pushes the branch and opens a pull request. It names the
   advisories the release fixes when cargo-audit is installed.

A failure after the merge also opens an issue. Nothing is done twice: an
open pull request for the release (labelled `security` under
--security) or an open issue with the same title stops the run. Under
--security with no newer upstream release, an issue asks for a backport.

Usage: admin/ringline-update [--upstream URL] [--push] [--security]
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib

UPSTREAM = "https://github.com/rustls/rustls.git"
LOCKFILES = {"Cargo.lock": "Cargo.toml", "fuzz/Cargo.lock": "fuzz/Cargo.toml"}


class Failed(Exception):
    pass


def run(*args, check=True, cwd=None):
    r = subprocess.run(args, capture_output=True, text=True, cwd=cwd)
    if check and r.returncode != 0:
        raise Failed(f"`{' '.join(args)}` failed:\n{r.stdout}{r.stderr}")
    return r.stdout.strip()


def version_tuple(v):
    return tuple(int(x) for x in v.split("."))


def merged_upstream():
    m = re.search(r"^Upstream: v/(\d+\.\d+\.\d+)$", open("RINGLINE.md").read(), re.M)
    if not m:
        sys.exit("RINGLINE.md: no `Upstream: v/X.Y.Z` line")
    return m.group(1)


def fork_version():
    text = open("rustls/Cargo.toml").read()
    return re.search(r'^version = "(\d+\.\d+\.\d+)"$', text, re.M).group(1)


def newest_on_line(upstream_url, current):
    line = ".".join(current.split(".")[:2])
    run("git", "fetch", "--quiet", upstream_url, f"refs/tags/v/{line}.*:refs/tags/v/{line}.*")
    tags = run("git", "tag", "--list", f"v/{line}.*").split()
    versions = [t[2:] for t in tags if re.fullmatch(rf"v/{re.escape(line)}\.\d+", t)]
    newer = [v for v in versions if version_tuple(v) > version_tuple(current)]
    return max(newer, key=version_tuple) if newer else None


def renamed_tree(tag, version, trees):
    """A temporary worktree at `tag` with admin/ringline-apply-rename applied.
    It is appended to `trees` before anything can fail, for the caller to
    remove."""
    tmp = tempfile.mkdtemp(prefix="ringline-update-")
    trees.append(tmp)
    run("git", "worktree", "add", "--quiet", "--detach", tmp, f"refs/tags/{tag}")
    os.makedirs(os.path.join(tmp, "admin"), exist_ok=True)
    shutil.copy("admin/ringline-apply-rename", os.path.join(tmp, "admin"))
    run("python3", "admin/ringline-apply-rename", "--version", version, cwd=tmp)
    return tmp


def resolve(paths, old_tag, new_tag, version):
    """Three-way merge each path with both upstream copies renamed. Returns
    {path: merged bytes, or None to delete} for the paths that resolve: a
    clean merge, or an upstream deletion of a file whose fork copy is the
    renamed old upstream copy."""
    if not paths:
        return {}
    trees = []
    try:
        old = renamed_tree(old_tag, version, trees)
        new = renamed_tree(new_tag, version, trees)
        merged = {}
        for p in paths:
            ours = subprocess.run(["git", "show", f"HEAD:{p}"], capture_output=True)
            base, theirs = os.path.join(old, p), os.path.join(new, p)
            if ours.returncode != 0 or not os.path.exists(base):
                continue
            if not os.path.exists(theirs):
                if ours.stdout == open(base, "rb").read():
                    merged[p] = None
                continue
            with tempfile.NamedTemporaryFile(delete=False) as f:
                f.write(ours.stdout)
            try:
                r = subprocess.run(["git", "merge-file", "-p", f.name, base, theirs], capture_output=True)
            finally:
                os.unlink(f.name)
            if r.returncode == 0:
                merged[p] = r.stdout
        return merged
    finally:
        for t in trees:
            run("git", "worktree", "remove", "--force", t, check=False)
            shutil.rmtree(t, ignore_errors=True)
        run("git", "worktree", "prune", check=False)


def advisory_ids(version):
    """RustSec IDs against rustls `version`, or None without cargo-audit."""
    if shutil.which("cargo-audit") is None:
        return None
    out = subprocess.run(
        ["python3", "admin/ringline-advisory-check", "--ids", version], capture_output=True, text=True
    )
    return set(out.stdout.split()) if out.returncode == 0 else None


def gh(*args, check=True):
    return run("gh", *args, check=check)


def open_issue(title, body, push, security):
    print(body)
    if push and gh("issue", "list", "--search", f'"{title}" in:title', "--state", "open",
                   "--json", "number", "--jq", "length") == "0":
        args = ["issue", "create", "--title", title, "--body", body]
        if security:
            args += ["--label", "security"]
        gh(*args)


def lock_versions(text):
    """{name: [versions]} from the text of a Cargo.lock."""
    out = {}
    for pkg in tomllib.loads(text).get("package", []):
        out.setdefault(pkg["name"], []).append(pkg["version"])
    return out


def lock_at(rev, path):
    """{name: [versions]} from `path` at git revision `rev`, or {} if absent."""
    r = subprocess.run(["git", "show", f"{rev}:{path}"], capture_output=True, text=True)
    return lock_versions(r.stdout) if r.returncode == 0 else {}


def locked_versions(lockfile):
    """{name: [versions]} from a Cargo.lock in the working tree, or {}."""
    return lock_versions(open(lockfile).read()) if os.path.exists(lockfile) else {}


def compatible(a, b):
    """Whether semver versions a and b are compatible (same major, or same
    minor under 0.x, or same patch under 0.0.x)."""
    va, vb = (re.match(r"(\d+)\.(\d+)\.(\d+)", v).groups() for v in (a, b))
    if va[0] != "0":
        return va[0] == vb[0]
    if va[1] != "0":
        return va[:2] == vb[:2]
    return va == vb


def restore_bumps(lock, manifest, forked):
    """Re-lock the packages the fork moved (`forked`: {name: [versions]},
    only packages whose fork lock differs from the old upstream lock) where
    the fork's version is newer than, and compatible with, the current lock.
    The lock is re-read before each re-lock, since one can move another
    package. Packages locked at several versions are left alone. Returns the
    re-locks cargo refused, as (lock, name, fork version, kept version,
    cargo's first `error:` line, or its last line when there is none)."""
    refused = []
    for name, old in forked.items():
        new = locked_versions(lock).get(name, [])
        if len(old) != 1 or len(new) != 1 or old[0] == new[0]:
            continue
        if compatible(old[0], new[0]) and version_tuple(re.match(r"[\d.]+\d", old[0]).group()) > \
                version_tuple(re.match(r"[\d.]+\d", new[0]).group()):
            r = subprocess.run(["cargo", "update", "--quiet", "--manifest-path", manifest,
                                "-p", f"{name}@{new[0]}", "--precise", old[0]], capture_output=True)
            if r.returncode != 0:
                lines = r.stderr.decode(errors="replace").strip().splitlines()
                errors = [x for x in lines if x.startswith("error:")]
                reason = errors[0] if errors else (lines[-1] if lines else "no error output")
                refused.append((lock, name, old[0], new[0], reason))
    return refused


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--upstream", default=UPSTREAM)
    ap.add_argument("--push", action="store_true", help="push the branch and open a pull request or issue")
    ap.add_argument("--security", action="store_true", help="an advisory started this run")
    opts = ap.parse_args()
    # Plain cargo output: the reasons quoted in issues and pull requests are
    # read from it. CI sets CARGO_TERM_COLOR=always.
    os.environ["CARGO_TERM_COLOR"] = "never"

    base_branch = run("git", "rev-parse", "--abbrev-ref", "HEAD")
    if opts.push and opts.security:
        gh("label", "create", "security", "--color", "d73a4a", "--force")
    current = merged_upstream()
    newest = newest_on_line(opts.upstream, current)
    if newest is None:
        print(f"no upstream release after v/{current}")
        if opts.security:
            open_issue(
                f"Advisory against rustls v/{current} with no newer 0.23 release",
                f"The advisory check reports an advisory against rustls `v/{current}`, which "
                f"`{base_branch}` contains, and upstream has no newer release on this line. The "
                f"fix needs backporting by hand. Run `admin/ringline-advisory-check` for the IDs.",
                opts.push,
                opts.security,
            )
        return
    tag = f"v/{newest}"
    branch = f"ringline-update/{newest}"
    title = f"Merge upstream rustls {tag}"
    print(f"merging {tag} (merged: v/{current})")

    if opts.push:
        existing = gh("pr", "list", "--head", branch, "--state", "all", "--json", "number,state",
                      "--jq", '.[] | select(.state == "OPEN") | .number')
        if existing:
            if opts.security:
                gh("pr", "edit", existing.split()[0], "--add-label", "security")
            print(f"pull request #{existing.split()[0]} for {branch} is open")
            return
        issue = gh("issue", "list", "--search", f'"{title}" in:title', "--state", "open",
                   "--json", "number", "--jq", ".[0].number // empty")
        if issue:
            if opts.security:
                gh("issue", "edit", issue, "--add-label", "security")
            print(f"issue #{issue} for {tag} is open")
            return

    # The fork's version, read before a conflict replaces the manifest.
    major, minor, patch = version_tuple(fork_version())
    version = f"{major}.{minor}.{patch}"
    next_version = f"{major}.{minor}.{patch + 1}"

    run("git", "checkout", "--quiet", "-B", branch)
    try:
        merge = subprocess.run(["git", "merge", "--no-ff", "--no-commit", f"refs/tags/{tag}"],
                               capture_output=True, text=True)
        conflicts = run("git", "diff", "--name-only", "--diff-filter=U").split()
        if merge.returncode != 0 and not conflicts:
            raise Failed(f"git merge failed:\n{merge.stdout}{merge.stderr}")
        candidates = [f for f in conflicts if f not in LOCKFILES]
        merged = resolve(candidates, f"v/{current}", tag, version)
        other = [f for f in candidates if f not in merged]
        if other:
            run("git", "merge", "--abort")
            run("git", "checkout", "--quiet", base_branch)
            run("git", "branch", "-D", branch)
            open_issue(
                title,
                f"Merging upstream `{tag}` into `{base_branch}` conflicts in files that hold "
                f"ringline changes, which need resolving by hand:\n\n"
                + "".join(f"- `{f}`\n" for f in other)
                + f"\nMerged upstream so far: `v/{current}`.",
                opts.push,
                opts.security,
            )
            return
        for f, content in merged.items():
            if content is None:
                run("git", "rm", "--quiet", "--force", "--", f)
            else:
                with open(f, "wb") as out:
                    out.write(content)
        # The packages the fork moved in each lockfile: HEAD's locks that
        # differ from the old upstream tag's.
        forked = {}
        for f in LOCKFILES:
            upstream_before = lock_at(f"refs/tags/v/{current}", f)
            forked[f] = {n: v for n, v in lock_at("HEAD", f).items() if upstream_before.get(n) != v}
        for f in conflicts:
            if f in LOCKFILES:
                run("git", "checkout", "--theirs", "--", f)
        run("python3", "admin/ringline-apply-rename", "--version", next_version)
        text = open("RINGLINE.md").read()
        open("RINGLINE.md", "w").write(re.sub(r"^Upstream: v/\S+$", f"Upstream: {tag}", text, flags=re.M))
        refused = []
        for lock, manifest in LOCKFILES.items():
            if os.path.exists(manifest):
                run("cargo", "update", "--quiet", "--workspace", "--manifest-path", manifest)
                refused += restore_bumps(lock, manifest, forked.get(lock, {}))
        merged_files = [f for f in candidates if merged.get(f) is not None]
        deleted_files = [f for f in candidates if f in merged and merged[f] is None]
        report = (
            (f"Conflicts merged after admin/ringline-apply-rename: {', '.join(merged_files)}\n"
             if merged_files else "")
            + (f"Deleted upstream, fork changes mechanical only: {', '.join(deleted_files)}\n"
               if deleted_files else "")
            + "Lockfiles updated with cargo update --workspace, then the fork's newer compatible "
              "locks re-applied where cargo accepted them (packages locked at more than one "
              "version are not re-applied).\n"
            + "".join(f"{lk}: cargo refused to re-lock {n} {o} (kept {w}): {reason}\n"
                      for lk, n, o, w, reason in refused)
        )
        run("git", "add", "-A")
        run(
            "git", "commit", "--quiet", "-m",
            f"Merge upstream rustls {tag}; ringline-tls {next_version}\n\n"
            f"Upstream: {tag}\n" + report,
        )
    except Exception as e:
        run("git", "merge", "--abort", check=False)
        run("git", "reset", "--quiet", "--hard", check=False)
        run("git", "checkout", "--quiet", base_branch, check=False)
        run("git", "branch", "-D", branch, check=False)
        open_issue(title, f"Merging upstream `{tag}` into `{base_branch}` failed:\n\n```\n{e}\n```",
                   opts.push, opts.security)
        return
    print(f"committed on {branch}: ringline-tls {next_version}")

    if not opts.push:
        return
    old_ids, new_ids = advisory_ids(current), advisory_ids(newest)
    if old_ids is None or new_ids is None:
        advisories = "Advisories fixed: not checked (cargo-audit missing or the check failed).\n\n"
    elif old_ids - new_ids:
        advisories = f"Advisories fixed: {', '.join(sorted(old_ids - new_ids))}.\n\n"
    else:
        advisories = "Advisories fixed: none.\n\n"
    run("git", "push", "--quiet", "--force", "origin", branch)
    body = (
        f"Merges upstream rustls `{tag}` into `{base_branch}` and sets ringline-tls "
        f"{next_version}.\n\nUpstream: {tag}\n\n"
        + advisories
        + report + "\n"
        + f"Upstream changes: https://github.com/rustls/rustls/compare/v/{current}...{tag}\n\n"
        "Merge with a merge commit, not a squash. A squash leaves the upstream tag out of the "
        "branch's history, so the next update's merge uses the previous upstream tag as its "
        "base and conflicts on everything upstream changed since. "
        f"Then tag the merge commit `v{next_version}` to publish."
    )
    args = ["pr", "create", "--base", base_branch, "--head", branch, "--title", title, "--body", body]
    if opts.security:
        args += ["--label", "security"]
    gh(*args)


if __name__ == "__main__":
    main()
